# ============================================================
# CSTracker — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no repositório
# ============================================================

# ── FRONTEND (seguras para expor no browser) ─────────────────
# Obtidas em: Supabase → Settings → API → Project URL e anon key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AdSense (somente após aprovação da conta) ─────────────────
# Mantenha NEXT_PUBLIC_ADS_ENABLED=false até ter aprovação do AdSense
NEXT_PUBLIC_ADS_ENABLED=false
# Publisher ID (formato: ca-pub-XXXXXXXXXXXXXXXX) — configure após aprovação
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
# IDs dos ad units — configure após criar os anúncios no AdSense
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_GRENADES=

# ── Pix (opcional — configure para ativar o botão de apoio) ───
NEXT_PUBLIC_PIX_ENABLED=false
# Sua chave Pix (CPF, CNPJ, e-mail, telefone ou chave aleatória)
NEXT_PUBLIC_PIX_KEY=
# URL do QR Code gerado pelo seu banco (opcional)
NEXT_PUBLIC_PIX_QR_URL=
# URL de pagamento direto (opcional — ex: link do Mercado Pago)
NEXT_PUBLIC_PIX_PAYMENT_URL=

# ── BACKEND APENAS (NUNCA exponha estas no frontend) ─────────
# Usadas somente no GitHub Actions / scripts Python locais
# NÃO adicione NEXT_PUBLIC_ nestas variáveis
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Seu Steam ID 64-bit — encontre em steamid.io ou no perfil Steam
PLAYER_STEAM_ID=76561198xxxxxxxxx
